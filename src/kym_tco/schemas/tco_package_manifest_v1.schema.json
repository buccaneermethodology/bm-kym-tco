{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kym_tco.tco_package_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "package_id", "product_id", "state_axes", "result",
    "finding_code", "command_evidence", "artifact_index",
    "self_integrity", "claim_ceiling"
  ],
  "properties": {
    "schema": {"const": "kym_tco.tco_package_manifest.v1"},
    "package_id": {"type": "string", "pattern": "^tco-package-[0-9a-f]{12}$"},
    "product_id": {"type": "string", "minLength": 1},
    "state_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_status", "package_execution_status", "candidate_status", "verification_status", "audit_status", "approval_status"],
      "properties": {
        "environment_status": {"const": "ready"},
        "package_execution_status": {"enum": ["completed", "completed_with_findings", "blocked", "failed"]},
        "candidate_status": {"enum": ["candidate_not_approved", "invalid_candidate", "not_generated"]},
        "verification_status": {"enum": ["not_run", "passed", "failed"]},
        "audit_status": {"enum": ["not_run", "passed", "findings", "blocker"]},
        "approval_status": {"const": "not_requested"}
      }
    },
    "result": {"enum": ["candidate_package_ready", "candidate_schema_invalid", "verification_empty", "verification_failed", "source_mutated", "candidate_audit_blocked", "policy_blocked", "publish_failed"]},
    "finding_code": {"type": ["string", "null"]},
    "command_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "argv", "cwd", "exit_code", "summary", "evidence_path", "engine_identity", "shell"],
        "properties": {
          "step": {"type": "string"},
          "argv": {"type": "array", "minItems": 2, "prefixItems": [{"const": "tco"}, {"const": "package-candidate"}], "items": {"type": "string", "not": {"pattern": "[Aa][Pp][Pp][Rr][Oo][Vv][Ee]"}}},
          "cwd": {"const": "workspace"},
          "exit_code": {"type": "integer"},
          "summary": {"type": "string"},
          "evidence_path": {"type": ["string", "null"]},
          "engine_identity": {"const": "in_process_shared_function"},
          "shell": {"const": false}
        }
      }
    },
    "artifact_index": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"const": "artifact-index.json"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "self_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "digest_algorithm", "checksum_ref"],
      "properties": {
        "path": {"const": "package-manifest.json"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "digest_algorithm": {"const": "sha256_canonical_json_without_self_integrity_digest"},
        "checksum_ref": {"const": "package-manifest.sha256"}
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "candidate_package_ready"}}, "required": ["result"]},
      "then": {"properties": {"artifact_index": {"type": "object"}}, "oneOf": [
        {"properties": {"finding_code": {"type": "null"}, "state_axes": {"properties": {"package_execution_status": {"const": "completed"}, "candidate_status": {"const": "candidate_not_approved"}, "verification_status": {"const": "passed"}, "audit_status": {"const": "passed"}}}}},
        {"properties": {"finding_code": {"const": "PACKAGE_COVERAGE_NOT_EVALUATED"}, "state_axes": {"properties": {"package_execution_status": {"const": "completed"}, "candidate_status": {"const": "candidate_not_approved"}, "verification_status": {"const": "not_run"}, "audit_status": {"const": "passed"}}}}},
        {"properties": {"finding_code": {"const": "PACKAGE_AUDIT_FINDINGS"}, "state_axes": {"properties": {"package_execution_status": {"const": "completed_with_findings"}, "candidate_status": {"const": "candidate_not_approved"}, "verification_status": {"const": "passed"}, "audit_status": {"const": "findings"}}}}},
        {"properties": {"finding_code": {"const": "PACKAGE_COVERAGE_NOT_EVALUATED"}, "state_axes": {"properties": {"package_execution_status": {"const": "completed_with_findings"}, "candidate_status": {"const": "candidate_not_approved"}, "verification_status": {"const": "not_run"}, "audit_status": {"const": "findings"}}}}}
      ]}
    },
    {
      "if": {"properties": {"result": {"const": "candidate_schema_invalid"}}, "required": ["result"]},
      "then": {"properties": {"finding_code": {"const": "PACKAGE_CANDIDATE_SCHEMA_INVALID"}, "state_axes": {"properties": {"package_execution_status": {"const": "failed"}, "candidate_status": {"const": "invalid_candidate"}, "verification_status": {"const": "not_run"}, "audit_status": {"const": "not_run"}}}}}
    },
    {
      "if": {"properties": {"result": {"enum": ["verification_empty", "verification_failed"]}}, "required": ["result"]},
      "then": {"oneOf": [
        {"properties": {"result": {"const": "verification_empty"}, "finding_code": {"const": "PACKAGE_VERIFICATION_EMPTY"}}},
        {"properties": {"result": {"const": "verification_failed"}, "finding_code": {"const": "PACKAGE_VERIFICATION_FAILED"}}}
      ], "properties": {"state_axes": {"properties": {"package_execution_status": {"const": "failed"}, "candidate_status": {"const": "candidate_not_approved"}, "verification_status": {"const": "failed"}, "audit_status": {"const": "not_run"}}}}}
    },
    {
      "if": {"properties": {"result": {"const": "source_mutated"}}, "required": ["result"]},
      "then": {"properties": {"finding_code": {"const": "PACKAGE_COVERAGE_MUTATION_FORBIDDEN"}, "state_axes": {"properties": {"package_execution_status": {"const": "failed"}, "candidate_status": {"const": "candidate_not_approved"}, "audit_status": {"const": "not_run"}}}}}
    },
    {
      "if": {"properties": {"result": {"const": "candidate_audit_blocked"}}, "required": ["result"]},
      "then": {"properties": {"finding_code": {"const": "PACKAGE_AUDIT_BLOCKER"}, "state_axes": {"properties": {"package_execution_status": {"const": "blocked"}, "candidate_status": {"const": "candidate_not_approved"}, "audit_status": {"const": "blocker"}}}}}
    },
    {
      "if": {"properties": {"result": {"const": "policy_blocked"}}, "required": ["result"]},
      "then": {"properties": {"finding_code": {"const": "PACKAGE_PROTECTED_READ_FORBIDDEN"}, "state_axes": {"properties": {"package_execution_status": {"const": "blocked"}, "candidate_status": {"const": "not_generated"}, "verification_status": {"const": "not_run"}, "audit_status": {"const": "not_run"}}}}}
    },
    {
      "if": {"properties": {"result": {"const": "publish_failed"}}, "required": ["result"]},
      "then": {"properties": {"finding_code": {"const": "PACKAGE_PUBLISH_FAILED"}, "state_axes": {"properties": {"package_execution_status": {"const": "failed"}, "candidate_status": {"const": "candidate_not_approved"}, "audit_status": {"enum": ["passed", "findings"]}}}}}
    }
  ]
}
