{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "workspace_boundary", "inputs", "manifest_digest"],
  "properties": {
    "schema_version": {"const": "source_input_manifest_v1"},
    "manifest_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "workspace_boundary": {"const": "."},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "kind", "requirement", "source", "boundary"],
      "properties": {
        "input_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "kind": {"enum": ["repo", "conversation_text", "file_set", "dashboard", "kb", "kym", "target", "tco_model", "coverage"]},
        "requirement": {"enum": ["required", "optional"]},
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "text", "byte_digest"],
              "properties": {
                "mode": {"const": "inline_text"},
                "text": {"type": "string", "minLength": 1},
                "byte_digest": {"$ref": "#/$defs/digest"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "refs"],
              "properties": {
                "mode": {"const": "workspace_paths"},
                "refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "byte_digest"],
                    "properties": {
                      "path": {"type": "string", "minLength": 1},
                      "byte_digest": {"$ref": "#/$defs/digest"}
                    }
                  }
                }
              }
            }
          ]
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_ref", "include_patterns", "exclude_patterns", "requested_closure"],
          "properties": {
            "root_ref": {"type": "string"},
            "include_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "exclude_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "requested_closure": {"enum": ["declared_closure", "selected_closure", "full_source_closure"]}
          }
        }
      }
    }
  }
}
