{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kym_tco.kym_package_artifact_index.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "artifacts"],
  "properties": {
    "schema": {"const": "kym_tco.kym_package_artifact_index.v1"},
    "package_id": {"type": "string", "pattern": "^kym-package-[0-9a-f]{12}$"},
    "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "path_scope", "digest", "producer", "candidate_boundary"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"}, "path_scope": {"enum": ["product_root", "package_dir"]}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "producer": {"type": "string", "minLength": 1}, "candidate_boundary": {"const": "candidate_not_approved"}}}}
  }
}
