{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "registry_id", "registry_version", "registry_digest", "rules", "gates", "input_kind_applicability", "aggregate_readiness", "claim_ceiling"],
  "properties": {
    "schema": {"const": "kym_tco.gate_registry.v1"}, "registry_id": {"const": "s116-gate-registry"}, "registry_version": {"const": "1.0"},
    "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["rule_id", "predicate", "evidence_fields"], "properties": {"rule_id": {"type": "string", "pattern": "^RULE-[A-Z0-9-]+$"}, "predicate": {"type": "string", "minLength": 1}, "evidence_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "gates": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "stage", "applicability_rule_id", "predicate_evidence", "dependencies", "required_when_applicable"], "properties": {"gate_id": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"}, "stage": {"enum": ["host", "preflight", "source", "target", "kym", "tco", "optional-audit", "report", "aggregate", "final"]}, "applicability_rule_id": {"type": "string", "pattern": "^RULE-[A-Z0-9-]+$"}, "predicate_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"}}, "required_when_applicable": {"const": true}}}},
    "input_kind_applicability": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["input_kind", "axes"], "properties": {"input_kind": {"enum": ["repo", "conversation_text", "file_set", "dashboard", "kb", "kym", "target", "tco_model", "coverage", "mixed"]}, "axes": {"type": "object", "minProperties": 10, "maxProperties": 10, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["expectation", "rule_id"], "properties": {"expectation": {"enum": ["required", "conditional", "not_applicable"]}, "rule_id": {"type": "string", "pattern": "^RULE-[A-Z0-9-]+$"}}}}}}},
    "aggregate_readiness": {"type": "object", "additionalProperties": false, "required": ["unknown_gate", "duplicate_gate", "missing_gate", "missing_predicate_evidence", "dependency_failure", "required_applicable_terminal", "not_applicable_requires_recomputation", "ready_requires"], "properties": {"unknown_gate": {"const": "blocked"}, "duplicate_gate": {"const": "blocked"}, "missing_gate": {"const": "blocked"}, "missing_predicate_evidence": {"const": "blocked"}, "dependency_failure": {"const": "blocked"}, "required_applicable_terminal": {"const": "passed"}, "not_applicable_requires_recomputation": {"const": true}, "ready_requires": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}}},
    "claim_ceiling": {"const": "design_only_registry_contract_no_pipeline_readiness"}
  }
}
