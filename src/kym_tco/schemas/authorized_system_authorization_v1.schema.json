{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authorization_id", "product_id", "system_id", "approval_scopes", "target_ids", "approval_reference_prefix", "goal_ref", "authorized_by", "authorized_at", "expires_at"],
  "properties": {
    "schema": {"const": "kym_tco.authorized_system_authorization.v1"},
    "authorization_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "product_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "system_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "approval_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["kym_baseline", "target_profile", "coverage_delta"]}},
    "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
    "approval_reference_prefix": {"type": "string", "minLength": 1},
    "goal_ref": {"type": "string", "minLength": 1},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1}
  }
}
