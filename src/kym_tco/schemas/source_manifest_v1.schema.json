{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_id", "original_name", "snapshot_ref", "digest", "line_count", "ingested_at", "turns", "chunks"],
  "properties": {
    "schema": {"const": "kym_tco.source_manifest.v1"},
    "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "original_name": {"type": "string", "minLength": 1},
    "snapshot_ref": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "line_count": {"type": "integer", "minimum": 1},
    "ingested_at": {"type": "string", "minLength": 1},
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speaker", "start_line", "end_line"],
        "properties": {
          "id": {"type": "string", "pattern": "^t[0-9]{4,}$"},
          "speaker": {"enum": ["user", "assistant", "chatgpt", "system", "developer", "unknown"]},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_line", "end_line", "char_count", "ref", "digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*-c[0-9]{4,}$"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "char_count": {"type": "integer", "minimum": 1},
          "ref": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
