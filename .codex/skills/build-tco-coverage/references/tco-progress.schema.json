{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product_id",
    "snapshot_id",
    "lifecycle",
    "cutoff",
    "included_stages",
    "excluded_stages",
    "tasks",
    "base_progress",
    "before",
    "after",
    "items",
    "requirements",
    "changes"
  ],
  "properties": {
    "schema": {
      "const": "tco_progress.v1"
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "const": "candidate_not_approved"
    },
    "cutoff": {
      "type": "string",
      "minLength": 1
    },
    "included_stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "excluded_stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "base_progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "before": {
      "$ref": "#/$defs/side"
    },
    "after": {
      "$ref": "#/$defs/side"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "minItems": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 0
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      },
      "minItems": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kym-tco.example/schemas/tco-progress.v1.json",
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "coverage",
        "report"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/ref"
        },
        "coverage": {
          "$ref": "#/$defs/ref"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "stage",
        "observed_at",
        "before",
        "after",
        "outcome",
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "enum": [
            "unknown",
            "not_started",
            "in_progress",
            "partial",
            "blocked",
            "completed"
          ]
        },
        "after": {
          "enum": [
            "unknown",
            "not_started",
            "in_progress",
            "partial",
            "blocked",
            "completed"
          ]
        },
        "outcome": {
          "enum": [
            "forward",
            "evidence_only",
            "gap_found",
            "regression",
            "no_change"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "m1_ids",
        "title",
        "acceptance",
        "requirement_ids",
        "owner",
        "next_step",
        "events"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "m1_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "next_step": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "m1_ids",
        "disposition",
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "m1_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "disposition": {
          "enum": [
            "retained",
            "revised",
            "resolved",
            "excluded"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 0
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "node",
            "profile"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1
        }
      }
    }
  }
}
